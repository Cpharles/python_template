[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [
    { name = "{{ author_name }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }
]
dependencies = []

{% if use_pytest %}
[dependency-groups]
dev = [
    "pytest>=8.0",
]
{% endif %}

{% if use_ruff %}
[tool.ruff]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = [
    "E",
    "F",
    "I",
    "B",
    "UP",
]

[tool.ruff.format]
quote-style = "double"
{% endif %}

{% if use_pytest %}
[tool.pytest.ini_options]
testpaths = ["tests"]
{% endif %}

[build-system]
requires = ["uv_build>=0.12.17,<0.13"]
build-backend = "uv_build"